# Copy to .env.local for `next dev`. Real values never go in git.
# On Cloudflare: public vars are build-time env; secrets go in with `wrangler secret put`.

# --- Supabase (used now: src/lib/supabase/*) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only (src/lib/supabase/service.ts). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Planned (referenced in docs, not read by code yet) ---
# Optional: project JWKS JSON, so getClaims() in the proxy never fetches keys on a cold isolate (docs/ui-map.md §1.3).
SUPABASE_JWKS=
# --- Sentry (wired in slice 0; every value optional, SDK stays off without a DSN) ---
# Browser DSN (instrumentation-client.ts), inlined at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Server DSN: `next dev` (sentry.server.config.ts) and the Worker env (worker.ts; set in wrangler vars).
SENTRY_DSN=
# Build-time source map upload (next.config.ts). Secret: CI/build env only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Not app env: set these in Supabase, not here ---
# Edge Function secret for price-ingest:   PRICE_INGEST_SECRET   (supabase secrets set)
# Vault secrets read by pg_cron:            project_url, price_ingest_secret
# (docs/data-model.md §15)

# --- Local Workers preview only: put this in .dev.vars (gitignored) ---
# NEXTJS_ENV=development
